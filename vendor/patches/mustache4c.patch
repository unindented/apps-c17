Lowercases the error messages of mustache.c and drops their trailing periods, as STYLE.md asks of
every diagnostic, and passes no empty tag name, which the parser already reports as missing, to
`mustache_validate_tagname`, which would read the byte before it. A standalone tag also drops the
indentation mark of the line that it consumes, so that inside an indented partial the line after
it is not indented twice.

--- a/mustache.c
+++ b/mustache.c
@@ -185,17 +185,17 @@
 
 /* Keep in sync with MUSTACHE_ERR_xxx constants. */
 static const char* mustache_err_messages[] = {
-    "Success.",
-    "Tag opener has no closer.",
-    "Tag closer has no opener.",
-    "Tag closer is incompatible with its opener.",
-    "Tag has no name.",
-    "Tag name is invalid.",
-    "Section-opening tag has no closer.",
-    "Section-closing tag has no opener.",
-    "Name of section-closing tag does not match corresponding section-opening tag.",
-    "The section-opening is located here.",
-    "Invalid specification of delimiters."
+    "success",
+    "tag opener has no closer",
+    "tag closer has no opener",
+    "tag closer is incompatible with its opener",
+    "tag has no name",
+    "tag name is invalid",
+    "section-opening tag has no closer",
+    "section-closing tag has no opener",
+    "name of section-closing tag does not match corresponding section-opening tag",
+    "the section-opening is located here",
+    "invalid specification of delimiters"
 };
 
 /* For the given template, we construct list of MUSTACHE_TAGINFO structures.
@@ -550,6 +550,17 @@
                 if(tmp_off == 0 || MUSTACHE_ISNEWLINE(templ_data[tmp_off-1])) {
                     current_tag.beg = tmp_off;
 
+                    /* The tag consumes its whole line, so the line gets no
+                     * inherited indentation either. Without this, the mark
+                     * of the next line follows straight after this one's,
+                     * and that line gets the indentation twice. */
+                    if(tags.n >= sizeof(MUSTACHE_TAGINFO)) {
+                        MUSTACHE_TAGINFO* last_tag = (MUSTACHE_TAGINFO*)
+                                (tags.data + tags.n - sizeof(MUSTACHE_TAGINFO));
+                        if(last_tag->type == MUSTACHE_TAGTYPE_INDENT  &&  last_tag->beg == tmp_off)
+                            tags.n -= sizeof(MUSTACHE_TAGINFO);
+                    }
+
                     if(current_tag.end < templ_size && templ_data[current_tag.end] == '\r')
                         current_tag.end++;
                     if(current_tag.end < templ_size && templ_data[current_tag.end] == '\n')
@@ -588,7 +599,8 @@
             }
 
             if(current_tag.type != MUSTACHE_TAGTYPE_COMMENT) {
