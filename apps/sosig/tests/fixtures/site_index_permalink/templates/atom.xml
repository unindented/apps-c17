<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{site.title}}</title>
  <link href="{{feed.url}}" rel="self"/>
  <link href="{{feed.html_url}}"/>
  <id>{{feed.id}}</id>
  <updated>{{feed.modified}}</updated>
{{#content_entries}}  <entry>
    <title>{{title}}</title>
    <link href="{{url}}"/>
    <id>{{url}}</id>
    <updated>{{modified}}</updated>
  </entry>
{{/content_entries}}</feed>
